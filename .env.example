# =============================================================================
# Ara Chat Service - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# Generate secrets with: openssl rand -base64 32

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
CHAT__HOST=0.0.0.0
CHAT__PORT=8082

# Run mode: development or production
RUN_MODE=development

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Secret key for JWT validation (minimum 32 characters, shared with backend)
# Generate with: openssl rand -base64 32
CHAT__JWT__SECRET=your-jwt-secret-key-minimum-32-characters

# Optional: Token issuer validation
CHAT__JWT__ISSUER=ara-services

# Optional: Token audience validation
CHAT__JWT__AUDIENCE=ara-services

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection URL
CHAT__DATABASE__URL=postgres://ara:ara_password@localhost:5432/ara_chat

# Connection pool settings
CHAT__DATABASE__MAX_CONNECTIONS=20
CHAT__DATABASE__MIN_CONNECTIONS=5

# Connection timeouts (seconds)
CHAT__DATABASE__ACQUIRE_TIMEOUT_SECONDS=30
CHAT__DATABASE__IDLE_TIMEOUT_SECONDS=300

# Run migrations on startup
CHAT__DATABASE__RUN_MIGRATIONS=true
CHAT__DATABASE__MIGRATIONS_PATH=./migrations

# Sharding (Citus distributed mode)
CHAT__DATABASE__SHARDING_ENABLED=false
CHAT__DATABASE__SHARD_COUNT=1024
# CHAT__DATABASE__COORDINATOR_URL=postgres://ara:ara_password@citus-coordinator:5432/ara_chat
# CHAT__DATABASE__WORKER_NODES=node1=postgres://...,node2=postgres://...

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Single node connection
CHAT__REDIS__URL=redis://localhost:6379
CHAT__REDIS__POOL_SIZE=10

# Redis Cluster mode (for production scale)
CHAT__REDIS__CLUSTER_ENABLED=false
# CHAT__REDIS__CLUSTER_NODES=redis://node1:6379,redis://node2:6379,redis://node3:6379

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
# Maximum total connections across all users
CHAT__WEBSOCKET__MAX_CONNECTIONS=100000

# Maximum connections per user (prevents abuse)
CHAT__WEBSOCKET__MAX_CONNECTIONS_PER_USER=5

# Heartbeat interval in seconds (for keepalive)
CHAT__WEBSOCKET__HEARTBEAT_INTERVAL_SECONDS=30

# Connection timeout in seconds (disconnect if no activity)
CHAT__WEBSOCKET__CONNECTION_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Cluster Mode (Multi-Instance Deployment)
# -----------------------------------------------------------------------------
# Enable cross-instance message routing via Redis Pub/Sub
CHAT__CLUSTER__ENABLED=false

# Unique identifier for this instance (auto-generated if not set)
CHAT__CLUSTER__SERVER_ID=chat-node-1

# Redis key prefix for session storage
CHAT__CLUSTER__SESSION_PREFIX=chat:cluster:sessions

# Redis Pub/Sub channel for message routing
CHAT__CLUSTER__ROUTING_CHANNEL=chat:cluster:route

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Allowed origins (comma-separated for production)
# Empty = allow any origin (development mode warning)
# CHAT__CORS__ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.example.com

# Allow credentials (cookies, authorization headers)
CHAT__CORS__ALLOW_CREDENTIALS=true

# Max age for preflight cache (seconds)
CHAT__CORS__MAX_AGE_SECONDS=3600

# -----------------------------------------------------------------------------
# File Storage (Attachments)
# -----------------------------------------------------------------------------
# Storage backend: local or s3
CHAT__FILE_STORAGE__BACKEND=local

# Maximum file size in bytes (default: 50MB)
CHAT__FILE_STORAGE__MAX_FILE_SIZE=52428800

# Enable thumbnail generation for images
CHAT__FILE_STORAGE__THUMBNAIL_ENABLED=true

# Maximum thumbnail dimension in pixels
CHAT__FILE_STORAGE__THUMBNAIL_MAX_DIMENSION=200

# Local storage path (when backend=local)
CHAT__FILE_STORAGE__LOCAL_PATH=./uploads

# S3/MinIO settings (when backend=s3)
# CHAT__FILE_STORAGE__S3_BUCKET=chat-files
# CHAT__FILE_STORAGE__S3_REGION=us-east-1
# CHAT__FILE_STORAGE__S3_ENDPOINT=http://minio:9000
# CHAT__FILE_STORAGE__S3_ACCESS_KEY=minioadmin
# CHAT__FILE_STORAGE__S3_SECRET_KEY=minioadmin
# CHAT__FILE_STORAGE__S3_PUBLIC_URL=http://localhost:9000/chat-files

# -----------------------------------------------------------------------------
# OpenTelemetry (Observability)
# -----------------------------------------------------------------------------
# Enable distributed tracing
CHAT__OTEL__ENABLED=false

# OTLP exporter endpoint
CHAT__OTEL__ENDPOINT=http://localhost:4317

# Service name for traces
CHAT__OTEL__SERVICE_NAME=ara-chat-service
